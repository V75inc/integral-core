# ============================================
# Integral — environment variables
# ============================================
# Copy this file to .env and update with your values.
# Canonical names follow jvspatial / jvagent convention. Integral reads
# JVSPATIAL_* directly via jvspatial.env.env() at Server() construction.

# ============================================
# Server
# ============================================
JVSPATIAL_HOST=0.0.0.0
JVSPATIAL_PORT=4000
JVSPATIAL_DEBUG=false
# Runtime mode read by jvspatial AND jvagent (development | production).
# Unset = development: jvagent's dev-mode behaviours stay on (debug report
# / interaction payloads in responses, --purge allowed). Deployed stacks
# pin JVSPATIAL_ENVIRONMENT=production in deploy/*.yml; set it here only
# when running a production-shaped box outside those stacks.
# JVSPATIAL_ENVIRONMENT=development
# NOTE: the bare `DEBUG` var (app/config.py, NOT the JVSPATIAL_-prefixed one
# above) is a DIFFERENT knob — it gates uvicorn's --reload in `python -m
# app.main` (see app/main.py `reload_enabled = settings.DEBUG`). It defaults
# to True and is intentionally left unset here so local dev gets live-reload
# out of the box. Do NOT add `DEBUG=false` to your local .env next to
# JVSPATIAL_DEBUG out of habit — that silently kills the backend reload loop
# (every code change then requires a manual server restart to take effect).
# Uvicorn worker count. Keep both at 1 until turn state is shared
# (docs/backend/adr/004-single-worker-until-shared-turn-state.md).
#
# - WORKERS — used by `python -m app.main` (ignored when DEBUG=True / reload).
# - WEB_CONCURRENCY — used by the Docker image CMD (`uvicorn --workers …`).
#   Defaults to 1 in backend/Dockerfile. Swarm stacks inherit that default.
#
# CAUTION: either knob >1 is not currently safe for chat. The in-flight turn
# registry and the agent-events websocket map are per-process, so
# one-turn-per-thread (I-CHAT-PAR-01) and MAX_CONCURRENT_TURNS_PER_USER hold
# only WITHIN a worker, and websocket pushes reach only clients connected to
# the emitting worker. The server warns at boot when
# max(WORKERS, WEB_CONCURRENCY, 1) > 1. Raise only once the registry lives in
# shared state.
# WORKERS=1
# WEB_CONCURRENCY=1

# ============================================
# Agentive layer (always on; integral-specific tuning)
# ============================================
# jvagent embed bootstrap update mode: source (default) | merge | run.
#   source = rebuild action nodes from agent.yaml every restart (YAML is truth).
#   merge  = update metadata in place, preserve runtime drift (production).
#   run    = skip existing actions, only register new ones.
# JVAGENT_UPDATE_MODE=merge
# jvagent's own HTTP surface (/api/agents/{id}/memory/..., /api/actions/{id},
# /api/logs, /api/graph, ...) is NOT mounted on the Integral app: main.py sets
# JVAGENT_EMBED_ENDPOINTS_DISABLED=1 before the Server is built. Integral
# reaches the resident through /api/chat and MCP only, and jvagent's
# auth=False interact routes register through the same path. Opt in ONLY
# for a local jvagent-admin debugging session, never on a deployed stack.
# JVAGENT_EMBED_ENDPOINTS_ENABLED=false
# WebSocket path for real-time agent events (default shown):
# AGENTIVE_WS_PATH=/ws/agent-events
# In-app chat: integral backend calls jvagent here (server-side).
# JVAGENT_BASE_URL=http://localhost:8000
# INTEGRAL_SERVICE_KEY=  # Shared with jvagent; enables service auth + system uplink
# Optional: comma-separated auth user ids the service key may impersonate.
# Empty = unrestricted (legacy). Prefer an allowlist in shared environments.
# INTEGRAL_SERVICE_ALLOWED_USER_IDS=
# Fallback agent id if not sent in register-system preferences:
# INTEGRAL_JVAGENT_AGENT_ID=

# ============================================
# Auth / JWT
# ============================================
# Master switch. Integral assumes auth is enabled in all environments.
JVSPATIAL_AUTH_ENABLED=true
# REQUIRED: at least 32 chars. Generate with: openssl rand -hex 32
JVSPATIAL_JWT_SECRET_KEY=replace-me-openssl-rand-hex-32-______________________
JVSPATIAL_JWT_ALGORITHM=HS256
JVSPATIAL_JWT_EXPIRE_MINUTES=30
# Refresh-token lifetime. Hard upper bound on a continuously-active
# session before the user must re-authenticate. The frontend silently
# exchanges refresh→access tokens while the user is interacting; idle
# clients let the access token expire and are logged out on next API
# call.
JVSPATIAL_REFRESH_EXPIRE_DAYS=7
# Rotate refresh tokens on every /auth/refresh call. Each successful
# refresh issues a new refresh token and revokes the previous one.
JVSPATIAL_REFRESH_TOKEN_ROTATION=true
REGISTRATION_OPEN=true

# Bootstrap admin (created on first launch when no admin exists)
# Set both to create admin user from env; min 6 chars for password
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your-secure-password
# ADMIN_NAME=Admin

# ============================================
# Database (jvspatial-canonical)
# ============================================
# db_type options: postgres | sqlite | json | mongodb | dynamodb
# Postgres is the recommended production backend (jvspatial Phase C,
# 2026-05-26): asyncpg + JSONB, walker BFS via recursive CTE, pgvector
# for hybrid graph+vector queries, multi-tenant RLS. See
# docs/md/postgres-guide.md in the jvspatial repo for the full surface.
JVSPATIAL_DB_TYPE=postgres

# Persist text exactly as authored.
#
# jvspatial defaults JVSPATIAL_TEXT_NORMALIZATION_ENABLED to true, which runs
# every persisted string through normalize_text_to_ascii: smart quotes and
# dashes are mapped to ASCII, diacritics are stripped via NFKD (cafe for
# cafe with an acute), and anything still non-ASCII is replaced with "?".
#
# It applies on the persistence path only, so the in-memory object keeps the
# original text and an API read looks correct -- the loss only surfaces after
# a restart, which makes it easy to mistake for a caching or encoding bug.
# Observed on a first-party bundle: a track description reading
# "backlog -> building" came back as "backlog ? building" once the process
# restarted, and repairing the row did not survive the next boot.
#
# The app does its own search folding in dedicated *_fold fields, so this
# framework-level folding of ALL text buys nothing and costs fidelity.
JVSPATIAL_TEXT_NORMALIZATION_ENABLED=false
JVSPATIAL_GRAPH_ENDPOINT_ENABLED=true

# --- PostgreSQL (default) ---
# DSN. Matches docker-compose.yml's `db` service (pgvector/pgvector:pg16
# on :5433, mapped to host :5433 to avoid colliding with any local
# default-port Postgres). Override for staging/prod (e.g. Neon, Aurora
# Serverless v2, RDS Proxy).
JVSPATIAL_POSTGRES_DSN=postgresql://integral:integral@localhost:5433/integral
# Pool sizing. Long-running containers: min=2, max=10 (jvspatial default).
# Serverless (Lambda / Cloud Functions): auto-tunes to min=0, max=3.
# JVSPATIAL_POSTGRES_MIN_POOL_SIZE=2
JVSPATIAL_POSTGRES_MAX_POOL_SIZE=10
# Pooler mode. Use "transaction" behind PgBouncer / RDS Proxy
# (disables asyncpg's prepared-statement cache for compat). Default
# "session" works on a direct PG connection.
# JVSPATIAL_POSTGRES_POOLER_MODE=session

# Integral does not use $all / $elemMatch; leave GIN off to avoid write tax.
JVSPATIAL_PG_GIN_INDEX=off

# Optional one-shot after upgrading a pre-0.0.18 volume: reclaim legacy node
# ``edges`` arrays with deploy/scripts/strip_node_edges.sh (idempotent).

# --- SQLite (single-node / local dev, file-based) ---
# Switch JVSPATIAL_DB_TYPE to "sqlite" for a zero-infra dev DB.
# JVSPATIAL_DB_TYPE=sqlite
# JVSPATIAL_DB_PATH=integral.db

# --- JSON (development only, human-readable on disk) ---
# Switch JVSPATIAL_DB_TYPE to "json" for the simplest dev backend.
# JVSPATIAL_DB_TYPE=json
# JVSPATIAL_DB_PATH=integral_db

# --- MongoDB Atlas (legacy fallback) ---
# Switch JVSPATIAL_DB_TYPE to "mongodb" and provide a connection string.
# Retained for environments still on the Atlas-vector retrieval path
# (see EMBEDDING_STORE_DRIVER below); new deployments should default
# to Postgres + pgvector instead.
# JVSPATIAL_DB_TYPE=mongodb
# JVSPATIAL_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# JVSPATIAL_MONGODB_DB_NAME=integral_prod
# JVSPATIAL_MONGODB_MAX_POOL_SIZE=25

# ============================================
# CORS Configuration (jvspatial-canonical)
# ============================================
# Integral reads JVSPATIAL_CORS_* directly via jvspatial.env.env() and
# passes them as a CORSConfig group to Server(). CSV form.
# Integral's built-in default list includes :9006 (Vite dev), :5173, :3000.
# JVSPATIAL_CORS_ENABLED=true
# JVSPATIAL_CORS_ORIGINS=http://localhost:9006,http://127.0.0.1:9006,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# JVSPATIAL_CORS_METHODS=*
# JVSPATIAL_CORS_HEADERS=Content-Type,Authorization,X-API-Key,X-Integral-Scope

# ============================================
# LLM API Keys
# ============================================
# Used by jvagent language-model actions (platform keys when BYOK is unset).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# Ollama — the DEFAULT heavy model in agent.yaml is `ollama/glm-5.3:cloud`.
#
# Both lines below are needed to reach Ollama Cloud. Without OLLAMA_API_BASE,
# LiteLLM resolves the host as `OLLAMA_API_BASE or http://localhost:11434`
# (llms/ollama/common_utils.py), so `ollama/...` silently targets a LOCAL
# Ollama daemon and fails with "Connect call failed 127.0.0.1:11434" on any
# machine that is not running the Ollama desktop app. The `:cloud` suffix is an
# Ollama-app concept — that app proxies to the cloud on your behalf — so it
# does NOT imply a cloud endpoint on its own.
#
# Setting OLLAMA_API_BASE points LiteLLM straight at the cloud and needs no
# daemon, no desktop app, and no signed-in Ollama account — just the key.
# OLLAMA_API_BASE=https://ollama.com
# OLLAMA_API_KEY=

# Wall-clock budget for one agent turn over the HTTP connector (seconds). A
# reasoning model that plans, reads a schema, queries and writes runs for
# minutes: measured resident-harness turns reach ~8 minutes. Too low a value
# does not degrade gracefully — it reports "Could not reach the agent service"
# for a healthy, still-running turn.
# INTEGRAL_AGENT_TURN_TIMEOUT_SECONDS=900

# Per-user BYOK (optional). See docs/backend/model-credentials-byok.md
# hybrid (default) = platform keys unless workspace owner saved BYOK
INTEGRAL_AGENT_KEY_MODE=hybrid
# byo_strict = require workspace owner's key (no platform fallback)
# platform_only = central keys only; ignore stored BYOK
#
# Required to persist user keys in production (32 bytes):
#   openssl rand -base64 32
INTEGRAL_CREDENTIAL_ENC_KEY=
# INTEGRAL_CREDENTIAL_ENC_KEY_PREVIOUS=
# Local-only: allow deriving a credential key from SECRET_KEY when DEBUG=true
# and INTEGRAL_CREDENTIAL_ENC_KEY is unset. Off by default (Full Sweep S7).
# INTEGRAL_CREDENTIAL_ALLOW_DEBUG_DERIVE=1

# ===== F0 / OSS — Core vs commercial Apps =====
# Commercial monorepo: Core seeds in backend/app/packages/ + Apps in packages/apps/.
# Empty = auto-include both when packages/apps exists. Core-only CI sets INTEGRAL_CORE_ONLY=1.
# INTEGRAL_PACKAGE_PATHS=backend/app/packages,packages/apps
# INTEGRAL_CORE_ONLY=0

# Rate limits (optional "<count>/<seconds>"). MCP / agentive / chat defaults
# apply when unset — see backend/app/middleware/rate_limit.py.
# RATE_LIMIT_MCP=120/60
# RATE_LIMIT_AGENTIVE=120/60
# RATE_LIMIT_CHAT=60/60
# RATE_LIMIT_PUBLIC_SHARE_WRITE=10/60

# ============================================
# Frontend Configuration
# ============================================
# API base URL (for staging/production; defaults to http://localhost:4000 in dev)
# VITE_API_URL=http://localhost:4000

# Keep in lockstep with INTEGRAL_WEB_ASSET_VERSION on deploy so stale SPA
# tabs can detect a new release via GET /api/meta/build and auto-reload once.
# VITE_WEB_ASSET_VERSION=0.1.0
# INTEGRAL_WEB_ASSET_VERSION=0.1.0

# Set to true to use mock API instead of real backend
# VITE_USE_MOCK_API=false

# Set to true to show dev login shortcuts (dev only, never in production)
# VITE_ENABLE_DEV_LOGINS=false

# Optional HTTPS endpoint that accepts POST JSON { name, payload, t }
# VITE_TELEMETRY_ENDPOINT=https://your-collector.example.com/events

# ============================================
# Password reset
# ============================================
# Reset tokens are single-use and expire after this many minutes.
# PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
# Hard cap on attempts before the token is invalidated.
# PASSWORD_RESET_MAX_ATTEMPTS=5
# Minimum new-password length on the reset form.
# PASSWORD_MIN_LENGTH=6

# ============================================
# Transactional email
# ============================================
# Provider: "console" (default — logs the message body, fine for dev),
# "resend" (calls https://api.resend.com/emails), or
# "sendgrid" (calls https://api.sendgrid.com/v3/mail/send).
# EMAIL_PROVIDER=console
# RESEND_API_KEY=re_yourkey
# SENDGRID_API_KEY=SG.yourkey
# EMAIL_FROM=noreply@gointegral.app
# EMAIL_FROM_NAME=Integral
# Public web origin used to build links inside email bodies (e.g. reset links).
# APP_BASE_URL=http://localhost:9006

# ============================================
# WhatsApp channel (optional, agentive)
# ============================================
# Enable in agent.yaml's whatsapp action context.
# WHATSAPP_ENABLED=false
# WHATSAPP_PROVIDER=wwebjs
# WHATSAPP_SESSION=integral-agent
# WHATSAPP_API_URL=http://localhost:21006
# WHATSAPP_API_KEY=
# Public URL for jvagent webhook callbacks (WhatsApp, other channels):
# JVAGENT_PUBLIC_BASE_URL=

# ============================================
# Service-auth user auto-create (D-02; security implications)
# ============================================
# When set to "1", a service-auth call with an unknown X-Integral-User-Id will
# silently spawn a graph User node (provided an upstream AuthUser exists).
# When unset/0, missing User nodes return HTTP 404 with the canonical envelope
# error_code `agentive.auth.user_node_missing`. Enable ONLY in trusted
# provisioning environments. Every successful auto-create emits an INFO log
# carrying the calling key fingerprint and the new auth_user_id for audit.
INTEGRAL_SERVICE_AUTO_CREATE_USERS=0

# ============================================
# Phase 2 — Knowledge Substrate (Provenance, Audit Log, Change Feed)
# ============================================
# Master kill switch for ChangeEvent emission, the audit log, the event feed,
# the WS broadcast, and the TTL reclaim loop. When false:
#   - emit_change_event constructs an in-memory envelope but does NOT persist
#   - GET /api/audit-log and GET /api/events return empty pages
#   - WS /api/events closes 1008 on connect
#   - the TTL reclaim loop is not spawned
# ChangeEvents are stored as DBLog rows with log_level="CHANGE_EVENT" in the
# logging database (JVSPATIAL_DB_LOGGING_DB_NAME) — mirrors the INTERACTION
# / AUDIT pattern from jvspatial.logging. The prime application graph holds
# no ChangeEvent rows.
CHANGE_EVENT_ENABLED=true

# ChangeEvent snapshot retention (D-04). After this many days, the before/after
# fields on a ChangeEvent are nulled out by the TTL reclaim job — the row
# itself NEVER deletes (append-only audit metadata persists forever).
CHANGE_EVENT_SNAPSHOT_TTL_DAYS=90

# How often the TTL reclaim job wakes (hours). Default 6 (D-15 option a —
# FastAPI startup spawns asyncio.create_task(ttl_reclaim_loop())).
CHANGE_EVENT_RECLAIM_INTERVAL_HOURS=6

# ============================================
# Phase 7 Plan 07-04 — Pending Agent Write TTL
# ============================================
# When a Policy with `requires_human_approval=True` intercepts an agent
# write, a PendingAgentWrite row is persisted with an `expires_at` stamped
# at +PENDING_WRITE_TTL_DAYS days from creation. The TTL reclaim loop
# wakes every PENDING_WRITE_RECLAIM_INTERVAL_HOURS and flips any pending
# row past its expires_at to status='expired' (emits pending_write.expired
# ChangeEvent). The payload field is NOT nulled on expiry — payloads
# remain forensic record (CONTEXT lock #4).
PENDING_WRITE_TTL_DAYS=7
PENDING_WRITE_RECLAIM_INTERVAL_HOURS=1.0

# Max serialized JSON byte size for a single PendingAgentWrite.payload.
# Exceeded payloads return HTTP 413 (PayloadTooLargeError) at the
# policy_engine intercept — the PendingAgentWrite is NOT persisted on
# overflow (the agent must retry with a smaller payload). Default 1MB.
PENDING_WRITE_PAYLOAD_MAX_BYTES=1048576

# Polling endpoint page-size cap (D-08). GET /api/events?since=<cursor>
# clamps any over-cap `limit` query param to this value. Default 100.
EVENT_FEED_PAGE_SIZE=100

# Audit-log query page-size hard cap (D-08). GET /api/audit-log?limit=N
# clamps over-cap to this value. Default 200.
AUDIT_LOG_PAGE_SIZE_MAX=200

# EVT-03 sample consumer opt-in (D-11). Default off in production, on in
# dev/test. When enabled, the summary_drafter consumer
# subscribes to ChangeEvents and drafts a summary Entry on tagged-entry
# arrival. NOT loaded into core.
AGENTIVE_SAMPLE_CONSUMER_ENABLED=0

# ============================================
# Logging
# ============================================
# Console logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Database Logging (jvspatial DB Logging subsystem)
JVSPATIAL_DB_LOGGING_ENABLED=true
# Comma-separated levels persisted to database. Default ERROR,CRITICAL.
JVSPATIAL_DB_LOGGING_LEVELS=ERROR,CRITICAL
JVSPATIAL_DB_LOGGING_DB_NAME=integral_logs
JVSPATIAL_DB_LOGGING_API_ENABLED=true

# Logging database — DBLog rows (ChangeEvents, audit log).
# Unset JVSPATIAL_LOG_DB_TYPE → mirrors JVSPATIAL_DB_TYPE (same cluster/DSN).
# Override only for zero-infra local dev:
#   JVSPATIAL_LOG_DB_TYPE=json
#   JVSPATIAL_LOG_DB_PATH=integral_logs
# Options: postgres | sqlite | json | mongodb | dynamodb
# JVSPATIAL_LOG_POSTGRES_DSN=   # optional; defaults to JVSPATIAL_POSTGRES_DSN

# MongoDB Logging Database (if JVSPATIAL_LOG_DB_TYPE=mongodb)
# JVSPATIAL_LOG_DB_URI=mongodb://localhost:27017
# JVSPATIAL_LOG_DB_NAME=jvspatial.logs

# DynamoDB Logging Database (if JVSPATIAL_LOG_DB_TYPE=dynamodb)
# JVSPATIAL_LOG_DB_TABLE_NAME=jvspatial.logs
# JVSPATIAL_LOG_DB_REGION=us-east-1
# JVSPATIAL_LOG_DB_ENDPOINT_URL=  # Optional, for local testing

# ============================================
# Production hardening
# ============================================
# Enable HSTS only when serving over HTTPS at a real hostname (NOT localhost).
# ENABLE_HSTS=1

# Per-endpoint auth rate limits — "<count>/<seconds>". Empty = sane defaults.
# RATE_LIMIT_LOGIN=10/60
# RATE_LIMIT_REGISTER=5/60
# RATE_LIMIT_FORGOT=3/60
# RATE_LIMIT_RESET=5/60
# RATE_LIMIT_DISABLED=0

# Content-Security-Policy customization (advanced).
# CSP_OVERRIDE=                  # full directive — overrides the built-in policy
# CSP_EXTRA_CONNECT=https://api.sentry.io   # extra hosts for connect-src
# CSP_EXTRA_IMG=                 # extra hosts for img-src

# ============================================
# Sentry (optional error reporting)
# ============================================
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_RELEASE=
# SENTRY_SEND_PII=0

# ============================================
# Optional: External Services
# ============================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# REDIS_URL=redis://localhost:6379

# ============================================
# Phase 4 — Hybrid Retrieval (RET-01 / RET-02)
# ============================================
# Embedding-store driver. Resolution:
#   auto    — pgvector when JVSPATIAL_DB_TYPE=postgres + JVSPATIAL_POSTGRES_DSN
#             is set (the default for Postgres deployments); atlas when
#             JVSPATIAL_DB_TYPE=mongodb + JVSPATIAL_MONGODB_URI is set;
#             else null (graph-only deployments; semantic / hybrid degrade
#             to graph and return ``degraded=true``).
#   pgvector — Postgres + pgvector (the `vector` extension) on the prime
#             cluster. Schema (table `entry_embedding`, HNSW index) is
#             created idempotently on first use. NEW / updated entries
#             embed automatically via the write hook; EXISTING entries need
#             a one-time backfill:
#                 python -m scripts.backfill_embeddings
#             (scope with --workspace/--track, smoke with --limit; the run
#             is idempotent — upsert ON CONFLICT — so it is safe to repeat).
#   atlas   — MongoDB Atlas Vector Search on the prime cluster. Index
#             name: entry_embedding_vector_idx (see docs/ops/DEPLOY.md).
#   null    — no-op store; explicit opt-in for graph-only deployments.
# EMBEDDING_STORE_DRIVER=auto
#
# Embedding runtime — fastembed (ONNX). The default model name maps to
# sentence-transformers/all-MiniLM-L6-v2 via fastembed's catalogue; same
# 384-dim output as the retired sentence-transformers/torch backend.
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# 1 = warm ONNX weights at boot (prod). 0 = lazy load (faster local startup).
EMBEDDING_MODEL_EAGER_LOAD=0
#
# Where fastembed caches the ONNX weights. Production images pre-bake
# the cache at this path during the docker build (see backend/Dockerfile).
# FASTEMBED_CACHE_PATH=/opt/fastembed_cache

# ============================================
# Phase 4 — Retrieval API (RET-03 — Plan 04-02)
# ============================================
# POST /api/retrieve over-fetch + return caps. The vector store is
# over-fetched at ``k`` candidates and trimmed to ``top_n`` after the
# per-candidate ``policy_engine.evaluate(action='entry.read')`` filter.
# Both surface via the request body (``k`` / ``top_n``) for advanced
# callers; these env vars are the platform-wide defaults.
# RETRIEVE_K_DEFAULT=150          # vector store over-fetch
# RETRIEVE_TOP_N_DEFAULT=20       # returned to caller after permission filter


# ============================================
# Phase IO-PERF — runtime tuning
# ============================================
# Postgres pool sizing is configured above under "Database
# (jvspatial-canonical)". MongoDB knobs retained below for the
# legacy-fallback path.
#
# MongoDB pool sizing (only when JVSPATIAL_DB_TYPE=mongodb). Default
# jvspatial pool is Lambda-tuned (max=10). Container deploys should
# raise the cap to absorb concurrent request bursts; tune downward
# only if you actively measure connection contention.
# JVSPATIAL_MONGODB_MAX_POOL_SIZE=50
# JVSPATIAL_MONGODB_MIN_POOL_SIZE=5
#
# Substrate index bootstrap. Default ON in non-serverless. Set to "false"
# to skip the boot-time ensure_indexes() loop for App Node/Edge classes
# (cold-start sensitive deploys). Index creation is idempotent — once
# materialized, subsequent boots no-op on the in-process registry.
# jvspatial ships default indexes since the indexing-optimization release:
# nodes get idx_node_entity (entity discriminator — first cut for every
# typed find), edges get idx_source_target_entity_unique plus
# idx_target_entity / idx_entity_source / idx_entity_target covering
# in/out/typed traversal shapes. No integral-side index definitions needed
# for these.
# JVSPATIAL_AUTO_CREATE_INDEXES=true
#
# Perf trace spans. When ON (1/true/yes), hot service paths emit structured
# `perf.span` log lines with duration_ms (see app.services.perf_trace).
INTEGRAL_PERF_TRACE=0
#
# Per-request DB round-trip counter in response header X-DB-Round-Trip-Count
# (see app.middleware.perf_header + app.services.db_metrics). Enable for
# baseline capture or N+1 debugging; keep off in production unless actively
# investigating. Requires JVSPATIAL_OBSERVABILITY_ENABLED=1 (the counter is
# fed by the ObservableDatabase wrapper) — without it the header reads 0.
INTEGRAL_PERF_HEADER_ENABLED=0
#
# Process-level TTL cache (seconds) for per-user permission aggregates and
# per-resource resolve_role results (see app.services.permissions_process_cache).
# Disabled when TESTING=1. Set to 0 to turn off. Invalidated on sharing /
# membership mutations via invalidate_user.
PERMISSION_PROCESS_CACHE_TTL=20
#
# Wrap the prime DB with ObservableDatabase instrumentation.
# JVSPATIAL_OBSERVABILITY_ENABLED=0
# JVSPATIAL_SLOW_QUERY_MS=150
#
# Postgres perf baseline tests (pytest only — not read at runtime):
# INTEGRAL_TEST_DB=postgres
# INTEGRAL_TEST_POSTGRES_DSN=postgresql://integral:integral@localhost:5433/integral_test
