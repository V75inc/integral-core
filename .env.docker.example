# Minimal .env for docker-compose.local.yml
# Copy to repo root: cp .env.docker.example .env

# Required — at least 32 chars. Compose refuses to start without it.
# Prefer: ./scripts/bootstrap_env.sh .env .env.example
JVSPATIAL_JWT_SECRET_KEY=replace-me-run-bootstrap-env-before-compose

# Persist text exactly as authored. jvspatial defaults this to true, which
# ASCII-folds every persisted string (arrows and dashes become "?", accents
# are stripped). It applies on the persistence path only, so the in-memory
# object keeps the original and the loss surfaces only after a restart.
# Integral does its own search folding in dedicated *_fold fields.
JVSPATIAL_TEXT_NORMALIZATION_ENABLED=false

# Optional bootstrap admin (created on first launch when no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
ADMIN_NAME=Admin

# Email links in console provider output
APP_BASE_URL=http://localhost:9006
EMAIL_PROVIDER=console

# Open registration for local testing
REGISTRATION_OPEN=true

OPENAI_API_KEY=

# Heavy gear uses ollama/glm-5.3:cloud — compose sets OLLAMA_API_BASE; key here:
# OLLAMA_API_KEY=
