# Copy to the deploy directory on the server as `.env` (never commit secrets).

# --- Images (set by CI in .env.deploy — do not commit real tags) ---
# API_IMAGE=ghcr.io/your-org/integral/api:prod-abc1234
# WEB_IMAGE=ghcr.io/your-org/integral/web:prod-abc1234

# --- Traefik routing (Swarm overlay network must be ``edge``) ---
#
# PICK THE BLOCK THAT MATCHES YOUR COMPOSE FILE. The two prod files route
# differently and this example must agree with the one you deploy:
#
#   deploy/docker-compose.prod.yml  → same-origin: /api path-routed on DOMAIN.
#                                     Set DOMAIN; leave DOMAIN_API unset;
#                                     VITE_API_URL = https://DOMAIN.
#   deploy/docker-stack.prod.yml    → SPLIT-HOST: api router is
#                                     Host(`${DOMAIN_API}`). DOMAIN_API is
#                                     REQUIRED and VITE_API_URL must be
#                                     https://DOMAIN_API — a same-origin value
#                                     here gives an SPA calling a static nginx
#                                     that cannot proxy, with healthchecks
#                                     green the whole time.
DOMAIN=integral.example.com
# REQUIRED for docker-stack.prod.yml (split-host); leave unset for
# docker-compose.prod.yml (same-origin).
# DOMAIN_API=api.integral.example.com
TRAEFIK_ROUTER_PREFIX=integral
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
# Optional second hostname for the SPA router (e.g. www)
# WWW_DOMAIN=www.integral.example.com

# --- Auth / database (required) ---
JVSPATIAL_AUTH_ENABLED=true
JVSPATIAL_JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JVSPATIAL_DB_TYPE=postgres

# Optional one-shot after upgrading a pre-0.0.18 volume: reclaim legacy node
# ``edges`` arrays with deploy/scripts/strip_node_edges.sh (idempotent).
JVSPATIAL_PG_GIN_INDEX=off
JVSPATIAL_POSTGRES_MAX_POOL_SIZE=10

# Persist text exactly as authored. jvspatial defaults this to true, which
# ASCII-folds every persisted string (arrows and dashes become "?", accents
# are stripped). It applies on the persistence path only, so the in-memory
# object keeps the original and the loss surfaces only after a restart.
# Integral does its own search folding in dedicated *_fold fields.
JVSPATIAL_TEXT_NORMALIZATION_ENABLED=false
# In-stack ``db`` service — POSTGRES_* is passed to both ``db`` and ``api``.
POSTGRES_USER=integral
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=integral_prod
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS: public site origin(s) — CSV
JVSPATIAL_CORS_ORIGINS=https://integral.example.com
JVSPATIAL_CORS_HEADERS=Content-Type,Authorization,X-API-Key,X-Integral-Scope
APP_BASE_URL=https://integral.example.com

# --- Frontend build (CI — baked into WEB_IMAGE) ---
# MUST match the routing block chosen above.
#   docker-compose.prod.yml (same-origin): https://DOMAIN — the default below.
#   docker-stack.prod.yml   (split-host):  https://DOMAIN_API, or omit
#     VITE_API_URL entirely and set DOMAIN_API — ci-resolve-vite-api-url.sh
#     prefers an explicit VITE_API_URL, then derives from DOMAIN_API, then
#     falls back to https://DOMAIN.
VITE_API_URL=https://integral.example.com

# --- SPA Content-Security-Policy (web container) — OPTIONAL ---
# connect-src defaults to the API origin this image was BUILT against:
# frontend/docker-entrypoint.d/15-csp-connect-default.envsh derives
# "https://<origin> wss://<origin>" from the VITE_API_URL build arg above — the
# same value the SPA's bundle calls — so the policy cannot drift from the app.
#
# Both routings are handled with nothing set here:
#   same-origin (deploy/docker-compose.prod.yml, API on DOMAIN by PathPrefix)
#     -> VITE_API_URL is DOMAIN, so connect-src allows exactly it
#   split-host  (deploy/docker-stack.prod.yml, API on Host(`${DOMAIN_API}`))
#     -> ci-resolve-vite-api-url.sh resolves VITE_API_URL to DOMAIN_API, and
#        the derived default follows it
#
# Set CSP_EXTRA_CONNECT only to ADD an origin beyond the SPA's own API; doing
# so REPLACES the derived default, so include the API origin too. Never set it
# empty — that overrides the default with nothing and blocks every XHR, which
# shows up only in the browser console while healthchecks stay green.
#
# CSP_EXTRA_IMG adds img-src origins, e.g. a CDN serving attachments.

# --- Agentive (embedded jvagent — agent/ baked into API image at /agent; always on) ---
# Prod: merge preserves API-driven runtime drift across restarts.
JVAGENT_UPDATE_MODE=merge
# Required for chat model calls (passed via api-env overlay at deploy).
OPENAI_API_KEY=

# --- Signup policy ---
# Default is OPEN self-registration (backend/app/config.py REGISTRATION_OPEN=True).
# For a private / client deployment, close it and provision users by invite:
# REGISTRATION_OPEN=false

# Attachment storage (required in production — use S3-compatible store)
# JVSPATIAL_FILE_STORAGE_PROVIDER=s3
# JVSPATIAL_S3_BUCKET_NAME=integral-attachments
# JVSPATIAL_S3_REGION=auto
# JVSPATIAL_S3_ENDPOINT_URL=https://account.r2.cloudflarestorage.com
# JVSPATIAL_S3_ACCESS_KEY=
# JVSPATIAL_S3_SECRET_KEY=

# Email (optional)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=

# jvagent distributed conversation lock (required when running >1 API worker)
# JVAGENT_CONVERSATION_LOCK_REDIS_URL=redis://redis:6379/0
# JVAGENT_CONVERSATION_LOCK_TTL_SECONDS=45

# jvspatial observability + read-through cache (multi-worker)
JVSPATIAL_OBSERVABILITY_ENABLED=1
JVSPATIAL_SLOW_QUERY_MS=100
JVSPATIAL_CACHE_GET_SIZE=500
# JVSPATIAL_CACHE_BACKEND=layered
# JVSPATIAL_REDIS_URL=redis://redis:6379/1
# EMAIL_FROM=noreply@integral.example.com
