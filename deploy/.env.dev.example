# Copy to GitHub secret DEV_ENV_FILE (and optionally the server as `.env.deploy`).
# Dev Swarm stack uses **two hostnames** — see deploy/docker-stack.dev.yml.
#
# At deploy, CI generates docker-stack.api-env.overlay.yml from application keys
# below (except DOMAIN*, TRAEFIK_*, POSTGRES_*, API_IMAGE, WEB_IMAGE, VITE_API_URL).
# POSTGRES_* is applied only via docker-stack.dev.yml at deploy time:
#   set -a && source .env.deploy && set +a && docker stack deploy ...
# main.py composes JVSPATIAL_POSTGRES_DSN from POSTGRES_* at API boot (not in container env).
#
# This stack has NO in-stack db service — point POSTGRES_* at an external/managed Postgres.
#
#   DOMAIN      → Traefik → web (nginx SPA)
#   DOMAIN_API  → Traefik → api (FastAPI)
#
# Values must stay consistent across runtime env and the frontend image build.

# --- Images (appended by CI — do not commit real tags) ---
# API_IMAGE=ghcr.io/your-org/integral/api:dev-abc1234
# WEB_IMAGE=ghcr.io/your-org/integral/web:dev-abc1234

# --- Traefik routing (overlay network must be ``edge``) ---
DOMAIN=integral-dev.example.com
DOMAIN_API=api.integral-dev.example.com
TRAEFIK_ROUTER_PREFIX=integral-dev
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# --- Agentive (embedded jvagent — agent/ baked into API image at /agent; always on) ---
# Dev: source rebuilds action nodes from agent.yaml every restart.
JVAGENT_UPDATE_MODE=source
# Required for chat model calls (passed via api-env overlay at deploy).
OPENAI_API_KEY=

# --- Auth / database (required) ---
JVSPATIAL_AUTH_ENABLED=true
JVSPATIAL_JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JVSPATIAL_DB_TYPE=postgres

# Optional one-shot after upgrading a pre-0.0.18 volume: reclaim legacy node
# ``edges`` arrays with deploy/scripts/strip_node_edges.sh (idempotent).
JVSPATIAL_PG_GIN_INDEX=off
JVSPATIAL_POSTGRES_MAX_POOL_SIZE=10

# Persist text exactly as authored. jvspatial defaults this to true, which
# ASCII-folds every persisted string (arrows and dashes become "?", accents
# are stripped). It applies on the persistence path only, so the in-memory
# object keeps the original and the loss surfaces only after a restart.
# Integral does its own search folding in dedicated *_fold fields.
JVSPATIAL_TEXT_NORMALIZATION_ENABLED=false
# External/managed Postgres (no in-stack db service). POSTGRES_* is excluded from the
# api-env overlay and interpolated directly into the api service in
# deploy/docker-stack.dev.yml at deploy time. POSTGRES_HOST is REQUIRED; the others
# default to integral / integral / integral_dev / 5432 if omitted.
POSTGRES_HOST=your-postgres-host.example.com
POSTGRES_PORT=5432
POSTGRES_USER=integral
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=integral_dev

# CORS + email/invite links: **web** origin only (not DOMAIN_API)
JVSPATIAL_CORS_ORIGINS=https://integral-dev.example.com
JVSPATIAL_CORS_HEADERS=Content-Type,Authorization,X-API-Key,X-Integral-Scope
APP_BASE_URL=https://integral-dev.example.com

# --- Bootstrap admin (API container — BOTH required; passed via stack overlay) ---
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-strong-password-min-6-chars
# ADMIN_NAME=Admin
#
# Do not set JVSPATIAL_POSTGRES_DSN here — POSTGRES_* above is composed into the DSN
# at API startup. A stale DSN pointing at localhost breaks bootstrap and leaves the
# object table empty while the API still passes healthchecks.

# --- Frontend build (CI build job — baked into WEB_IMAGE, not used at stack deploy) ---
# CI reads DEV_ENV_FILE and resolves VITE_API_URL from VITE_API_URL= or DOMAIN_API= below.
VITE_API_URL=https://api.integral-dev.example.com
# DOMAIN_API=api.integral-dev.example.com  # alternative if VITE_API_URL is omitted

# --- SPA Content-Security-Policy (web container) — OPTIONAL ---
# connect-src defaults to the API origin this image was BUILT against:
# frontend/docker-entrypoint.d/15-csp-connect-default.envsh derives
# "https://<origin> wss://<origin>" from the VITE_API_URL build arg, the same
# value the SPA's bundle calls. Nothing to set here for the normal case, and
# the policy cannot drift from the app because both come from one source.
#
# Set CSP_EXTRA_CONNECT only to ADD an origin the SPA calls beyond its own API.
# Setting it REPLACES the derived default, so include the API origin too:
#   CSP_EXTRA_CONNECT=https://api.example.com wss://api.example.com https://extra.example.com
#
# Do not set it empty — that overrides the default with nothing and blocks
# every XHR, a failure visible only in the browser console while every
# server-side healthcheck stays green.
#
# CSP_EXTRA_IMG adds img-src origins, e.g. a CDN serving attachments.
#
# NOTE: both keys also reach the API container through the api-env overlay
# (they are not in its deny-list), where the backend's SecurityHeadersMiddleware
# reads the same two names. That widens the API's own CSP identically —
# harmless, but be aware one value drives both.
