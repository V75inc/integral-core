# Copy to .env.sandbox (gitignored) and fill secrets.
# Used by scripts/sandbox-up.sh — does NOT replace root .env.

# --- isolation from commercial monorepo ---
JVSPATIAL_HOST=0.0.0.0
JVSPATIAL_PORT=4002
DEBUG=false
INTEGRAL_CORE_ONLY=1

JVSPATIAL_DB_TYPE=postgres
JVSPATIAL_POSTGRES_DSN=postgresql://integral:integral@localhost:5435/integral_core
JVSPATIAL_DB_LOGGING_DB_NAME=integral_core_logs

# Required (≥32 chars). Generate: openssl rand -hex 32
JVSPATIAL_JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-chars-min
JVSPATIAL_JWT_ALGORITHM=HS256
JVSPATIAL_JWT_EXPIRE_MINUTES=30

# Required. Generate: openssl rand -base64 32
INTEGRAL_CREDENTIAL_ENC_KEY=replace-with-openssl-rand-base64-32

INTEGRAL_SERVICE_KEY=dev-core-sandbox-service-key
INTEGRAL_AGENT_KEY_MODE=hybrid

# SPA on :9007 (monorepo keeps :9006)
JVSPATIAL_CORS_ORIGINS=http://localhost:9007,http://127.0.0.1:9007,http://localhost:9006,http://127.0.0.1:9006
APP_BASE_URL=http://localhost:9007

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-sandbox
ADMIN_NAME=Administrator

# Frontend (scripts/sandbox-up.sh also exports these for Vite)
VITE_BACKEND_URL=http://localhost:4002
VITE_ENABLE_DEV_LOGINS=true
