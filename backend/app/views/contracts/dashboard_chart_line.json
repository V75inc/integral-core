{
  "type": "chart_line",
  "label": "Line chart",
  "description": "Line or area chart of counts or governed aggregates over time.",
  "platforms": ["web"],
  "palette_group": "charts",
  "configurable": true,
  "hot_loadable": false,
  "default_size": { "w": 6, "h": 4 },
