<!doctype html>
<html>
  <body style="margin:0;padding:24px;font-family:-apple-system,Segoe UI,Inter,sans-serif;background:#fafafa;color:#0b0b0c;line-height:1.55;">
    <div style="max-width:480px;margin:0 auto;background:#ffffff;border:1px solid #ececef;border-radius:14px;padding:32px;">
      <p style="margin:0 0 16px 0;color:#4a4a52;font-size:14px;">
        <strong>{{ actor_name }}</strong> mentioned you in
        <a href="{{ app_url }}/entries/{{ resource_id }}" style="color:#ff5a1f;text-decoration:none;">{{ resource_label }}</a>.
      </p>
      <blockquote style="margin:0 0 24px 0;padding:12px 16px;border-left:3px solid #ececef;color:#4a4a52;font-size:14px;">
        {{ snippet }}
      </blockquote>
      <p style="margin:0 0 24px 0;">
        <a href="{{ app_url }}/entries/{{ resource_id }}" style="display:inline-block;background:#ff5a1f;color:#ffffff;padding:10px 18px;border-radius:8px;font-weight:600;text-decoration:none;font-size:14px;">
          Open in Integral
        </a>
      </p>
      <p style="margin:0;color:#8a8a93;font-size:12px;">
        You're receiving this because mentions are enabled in your notification preferences.
      </p>
    </div>
  </body>
</html>
